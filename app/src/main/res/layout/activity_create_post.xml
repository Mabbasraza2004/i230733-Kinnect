<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header: close, title, Post -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnClose"
            style="@style/IconButton"
            android:text="✕" />

        <TextView
            style="@style/TitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Create post" />

        <TextView
            android:id="@+id/btnPost"
            style="@style/TealButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Post" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Who is posting -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            style="@style/Avatar"
            android:text="AR" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/BodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="Abbas Raza" />

            <TextView
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="🌐 Public" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/etPost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:hint="What's on your mind?"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ink"
        android:textSize="20sp" />

    <!-- Options at the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowPhotoVideo"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="🖼   Photo/video" />

        <TextView
            android:id="@+id/rowCamera"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="📷   Camera" />

        <TextView
            android:id="@+id/rowTagPeople"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="👤   Tag people" />
    </LinearLayout>
</LinearLayout>
