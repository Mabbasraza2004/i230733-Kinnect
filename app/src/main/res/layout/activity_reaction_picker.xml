<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:background="@drawable/bg_tooltip"
        android:fontFamily="@font/figtree_bold"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="Love"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/reactionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_white"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="4dp"
            android:contentDescription="Like"
            android:src="@drawable/ic_react_like" />

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_margin="4dp"
            android:contentDescription="Love"
            android:src="@drawable/ic_react_love" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="4dp"
            android:contentDescription="Haha"
            android:src="@drawable/ic_react_haha" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="4dp"
            android:contentDescription="Wow"
            android:src="@drawable/ic_react_wow" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="4dp"
            android:contentDescription="Sad"
            android:src="@drawable/ic_react_sad" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="4dp"
            android:contentDescription="Angry"
            android:src="@drawable/ic_react_angry" />
    </LinearLayout>
</LinearLayout>
