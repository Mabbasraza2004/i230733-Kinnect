<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tab bar shared by Home, Friends, Marketplace, Notifications and Menu.
     It is added to each screen with <include>, and BottomNav.kt wires the clicks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@color/surface"
    android:elevation="8dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="⌂\nHome"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tabFriends"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="☺\nFriends"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tabMarketplace"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="⊞\nMarket"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tabNotifications"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="◉\nAlerts"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tabMenu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="≡\nMenu"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

</LinearLayout>
