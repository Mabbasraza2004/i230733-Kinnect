<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storyEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCloseEditor"
            style="@style/IconButton"
            android:text="✕"
            android:textColor="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Cycles the background colour -->
        <TextView
            android:id="@+id/btnChangeColour"
            style="@style/ChipButton"
            android:layout_width="wrap_content"
            android:text="🎨 Colour" />
    </LinearLayout>

    <!-- The user types straight onto the story -->
    <EditText
        android:id="@+id/etStoryText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:hint="Start typing"
        android:inputType="textMultiLine|textCapSentences"
        android:textColor="@color/white"
        android:textColorHint="@color/teal_light"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/btnShareStory"
        style="@style/TealButton"
        android:layout_width="match_parent"
        android:background="@drawable/bg_button_outline"
        android:backgroundTint="@color/white"
        android:text="Share to story"
        android:textColor="@color/white" />

</LinearLayout>
