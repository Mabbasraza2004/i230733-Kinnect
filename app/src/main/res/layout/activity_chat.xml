<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/ToolbarIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tvChatAvatar"
                style="@style/Avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/av_crimson"
                android:textSize="14sp" />

            <View
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_dot_online" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                style="@style/BodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:textSize="17sp" />

            <TextView
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active now" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnVoiceCall"
            style="@style/ToolbarIcon"
            android:contentDescription="Voice call"
            android:src="@drawable/ic_phone"
            android:tint="@color/teal" />

        <ImageView
            style="@style/ToolbarIcon"
            android:contentDescription="Video call"
            android:src="@drawable/ic_video"
            android:tint="@color/teal" />

        <ImageView
            style="@style/ToolbarIcon"
            android:contentDescription="Info"
            android:src="@drawable/ic_info"
            android:tint="@color/teal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvIntroAvatar"
                style="@style/Avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/av_crimson"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvIntroName"
                style="@style/SectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textSize="22sp" />

            <TextView
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="You're friends on Kinnect · Lives in Karachi" />

            <TextView
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/figtree_bold"
                android:letterSpacing="0.05"
                android:text="TODAY 4:49 PM" />

            <TextView
                style="@style/BubbleThem"
                android:text="Hey! Are you still coming Saturday?" />

            <TextView
                style="@style/BubbleThem"
                android:text="Lina booked the table for 8" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:backgroundTint="@color/av_crimson"
                    android:text="AK"
                    android:textSize="10sp" />

                <TextView
                    style="@style/BubbleThem"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:text="Bring the camera" />
            </LinearLayout>

            <TextView
                style="@style/BubbleMe"
                android:layout_marginTop="14dp"
                android:text="Yes, obviously" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end">

                <TextView
                    style="@style/BubbleMe"
                    android:layout_marginBottom="10dp"
                    android:text="Already charged both batteries" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/bg_circle_white"
                    android:elevation="2dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_react_love" />
            </FrameLayout>

            <TextView
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:text="You replied to Aisha"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_bubble_them"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:text="Lina booked the table for 8"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <TextView
                style="@style/BubbleMe"
                android:layout_marginTop="-8dp"
                android:text="Perfect, I'll be there by 7:45" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="230dp"
                android:layout_height="170dp"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_lilac" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="@color/av_crimson" />

            <LinearLayout
                android:id="@+id/typingRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:backgroundTint="@color/av_crimson"
                    android:text="AK"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_bubble_them"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="•••"
                    android:textColor="@color/ink_muted"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageView
            style="@style/ToolbarIcon"
            android:layout_width="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_add_circle"
            android:tint="@color/teal" />

        <ImageView
            style="@style/ToolbarIcon"
            android:layout_width="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_camera"
            android:tint="@color/teal" />

        <ImageView
            style="@style/ToolbarIcon"
            android:layout_width="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_image"
            android:tint="@color/teal" />

        <ImageView
            style="@style/ToolbarIcon"
            android:layout_width="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/etMessage"
                style="@style/FieldInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Aa"
                android:inputType="textCapSentences" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_smile"
                android:tint="@color/teal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSend"
            style="@style/ToolbarIcon"
            android:contentDescription="Send"
            android:src="@drawable/ic_like"
            android:tint="@color/teal" />
    </LinearLayout>
</LinearLayout>
