<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="6dp"
        android:drawableTint="#D9FFFFFF"
        android:gravity="center_vertical"
        android:letterSpacing="0.05"
        android:text="End-to-end encrypted"
        android:textColor="#D9FFFFFF"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_call_halo"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_call_halo"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvCallAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_square_call"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="52sp" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_bold"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_react_love" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Calling…"
        android:textColor="#E6FFFFFF"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_glass_light"
            android:contentDescription="Notes"
            android:padding="17dp"
            android:src="@drawable/ic_notes"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/bg_circle_glass_light"
            android:clickable="true"
            android:contentDescription="Mute"
            android:focusable="true"
            android:padding="17dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/btnEndCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/bg_end_call"
            android:clickable="true"
            android:contentDescription="End call"
            android:focusable="true"
            android:padding="20dp"
            android:src="@drawable/ic_end_call"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/bg_circle_glass_light"
            android:clickable="true"
            android:contentDescription="Speaker"
            android:focusable="true"
            android:padding="17dp"
            android:src="@drawable/ic_speaker"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
