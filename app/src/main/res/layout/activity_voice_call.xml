<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvCallAvatar"
        style="@style/Avatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_avatar_rust"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/tvCallName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/figtree_bold"
        android:textColor="@color/white"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Calling…"
        android:textColor="@color/teal_light"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Call controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSpeaker"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.6"
            android:background="@drawable/bg_avatar_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔊"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btnMute"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:alpha="0.6"
            android:background="@drawable/bg_avatar_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🎤"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btnEndCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/bg_end_call"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✆"
            android:textColor="@color/white"
            android:textSize="26sp" />
    </LinearLayout>
</LinearLayout>
