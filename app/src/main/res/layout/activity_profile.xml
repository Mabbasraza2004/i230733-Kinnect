<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/ToolbarIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvProfileTitle"
            style="@style/TitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Jacob West" />

        <ImageView
            style="@style/ToolbarIcon"
            android:contentDescription="Search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_sea" />

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="130dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_circle_chip"
                    android:contentDescription="Change cover photo"
                    android:padding="9dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/ink" />

                <FrameLayout
                    android:layout_width="146dp"
                    android:layout_height="146dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_circle_white"
                    android:padding="4dp">

                    <TextView
                        style="@style/Avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="JW"
                        android:textSize="48sp" />

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_circle_chip"
                        android:contentDescription="Change profile picture"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/ink" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    style="@style/HeadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Jacob West"
                    android:textSize="30sp" />

                <TextView
                    style="@style/MutedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_friend_count"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvProfileBio"
                    style="@style/BodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Digital goodies designer. Everything is designed."
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAddToStory"
                        style="@style/SmallTealButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_plus"
                        android:drawableTint="@color/white"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:text="Add to story" />

                    <TextView
                        android:id="@+id/btnEditProfile"
                        style="@style/SmallGreyButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_edit"
                        android:drawableTint="@color/ink"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:text="Edit profile" />

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_small_grey"
                        android:contentDescription="More"
                        android:padding="11dp"
                        android:src="@drawable/ic_more"
                        android:tint="@color/ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProfileTab"
                        android:background="@drawable/bg_pill_teal_light"
                        android:text="Posts"
                        android:textColor="@color/teal" />

                    <TextView
                        style="@style/ProfileTab"
                        android:text="Photos" />

                    <TextView
                        style="@style/ProfileTab"
                        android:text="Videos" />

                    <TextView
                        style="@style/ProfileTab"
                        android:text="Groups" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/divider" />

                <TextView
                    style="@style/SectionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:text="Details"
                    android:textSize="21sp" />

                <TextView
                    style="@style/DetailRow"
                    android:drawableStart="@drawable/ic_briefcase"
                    android:text="@string/detail_work" />

                <TextView
                    style="@style/DetailRow"
                    android:drawableStart="@drawable/ic_school"
                    android:text="@string/detail_study" />

                <TextView
                    style="@style/DetailRow"
                    android:drawableStart="@drawable/ic_location"
                    android:text="@string/detail_lives" />

                <TextView
                    style="@style/DetailRow"
                    android:drawableStart="@drawable/ic_clock"
                    android:text="Joined March 2019" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Friends"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="Find friends"
                        android:textColor="@color/teal"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    style="@style/MutedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="834 friends"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Avatar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_square"
                        android:backgroundTint="@color/av_purple"
                        android:text="LM"
                        android:textSize="34sp" />

                    <TextView
                        style="@style/Avatar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_square"
                        android:backgroundTint="@color/av_crimson"
                        android:text="AK"
                        android:textSize="34sp" />

                    <TextView
                        style="@style/Avatar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_square"
                        android:backgroundTint="@color/av_green"
                        android:text="OF"
                        android:textSize="34sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
