<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/ToolbarIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/ink_muted" />

            <EditText
                android:id="@+id/etSearch"
                style="@style/FieldInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Search Kinnect"
                android:inputType="text"
                android:text="omar" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="#9E9890"
                android:clickable="true"
                android:contentDescription="Clear"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_teal_light"
                android:text="All"
                android:textColor="@color/teal"
                android:textSize="14sp" />

            <TextView
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:text="People"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:text="Posts"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:text="Groups"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:text="Marketplace"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/SectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="People" />

            <LinearLayout
                android:id="@+id/resultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/SmallGreyButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="See all people" />

            <TextView
                style="@style/SectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Groups" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_square"
                    android:backgroundTint="@color/av_purple"
                    android:text="OP"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Omar's Photography Circle"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/MutedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Public · 2.4K members · 10+ posts a day" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnJoinGroup"
                    style="@style/SmallTealButton"
                    android:layout_width="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Join" />
            </LinearLayout>

            <TextView
                style="@style/SectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="Recent searches" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_chip"
                    android:padding="11dp"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/ink_muted" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="lina marsh"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/ink_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_chip"
                    android:padding="11dp"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/ink_muted" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="study desk karachi"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/ink_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_chip"
                    android:padding="11dp"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/ink_muted" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="SMD Class of 2026"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/ink_muted" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
