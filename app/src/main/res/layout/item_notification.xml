<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp">

        <TextView
            android:id="@+id/tvNotifAvatar"
            style="@style/Avatar"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:textSize="20sp" />

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_circle_white"
            android:padding="2dp">

            <ImageView
                android:id="@+id/ivNotifType"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar"
                android:padding="5dp"
                android:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotifText"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvNotifTime"
            style="@style/MutedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/notifButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnNotifConfirm"
                style="@style/SmallTealButton"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Confirm" />

            <TextView
                android:id="@+id/btnNotifDelete"
                style="@style/SmallGreyButton"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Delete" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        style="@style/ToolbarIcon"
        android:contentDescription="More"
        android:src="@drawable/ic_more"
        android:tint="@color/ink_muted" />
</LinearLayout>
