                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_empty"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </FrameLayout>

