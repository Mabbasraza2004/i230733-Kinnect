<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kinnect">

        <!-- The splash screen is the launcher entry point -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SignupActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".CommentsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ReactionPickerActivity" android:theme="@style/Theme.Kinnect.Dialog" />
        <activity android:name=".StoryViewerActivity" />
        <activity android:name=".CameraActivity" />
        <activity android:name=".StoryEditorActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".YourStoryActivity" />
        <activity android:name=".CreatePostActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PhotoPickerActivity" />
        <activity android:name=".ChatsActivity" />
        <activity android:name=".ChatActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VoiceCallActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".EditProfileActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FriendsActivity" />
        <activity android:name=".MarketplaceActivity" />
        <activity android:name=".NotificationsActivity" />
        <activity android:name=".MenuActivity" />
    </application>

</manifest>
